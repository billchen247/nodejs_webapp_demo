# ---------------------------------------------------------------------------
# .env.example — copy this to `.env` and tweak locally.
#
# Vite env rules (important!):
#   • Only variables prefixed with `VITE_` are inlined into the browser
#     bundle. Everything else stays server-side-only. This is a security
#     feature — don't ever put a secret in a VITE_ variable, because the
#     final bundle is public.
#   • Access them in code via `import.meta.env.VITE_FOO` (NOT process.env).
#
# @author Bill Chen
# ---------------------------------------------------------------------------

# Base URL for the backend REST API. Leave as "/api" in dev so Vite's proxy
# (see vite.config.ts) forwards calls to http://localhost:4000. For a
# production deployment where the frontend and backend live on different
# domains, set e.g. VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=/api

# A friendly label shown in the UI header — handy to confirm which build
# of the app you're looking at.
VITE_APP_TITLE=Todo — MERN Fullstack
