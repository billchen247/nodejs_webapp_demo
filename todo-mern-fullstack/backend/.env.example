# ---------------------------------------------------------------------------
# .env.example — copy this to `.env` and tweak locally.
#
# NEVER commit the real `.env` file. It is listed in `.gitignore`.
# `src/config/index.ts` loads these values via the `dotenv` package.
#
# @author Bill Chen
# ---------------------------------------------------------------------------

# Port the Express HTTP server listens on.
PORT=4000

# Node environment flag — morgan prints a different log format in production.
NODE_ENV=development

# MongoDB connection string. Local Mongo defaults to port 27017.
MONGODB_URI=mongodb://localhost:27017/todo_mern_fullstack

# Where the React dev server runs. Used by the CORS allow-list so your
# browser is permitted to call this API from a different origin.
CLIENT_ORIGIN=http://localhost:5173
