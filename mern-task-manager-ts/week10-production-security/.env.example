# Backend
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/mern_task_manager_week10
CLIENT_URL=http://localhost:5173
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
NODE_ENV=development

# Admin seeding (one-shot script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-8-chars

# Frontend (used only during Vite build/dev)
VITE_API_URL=http://localhost:3000
