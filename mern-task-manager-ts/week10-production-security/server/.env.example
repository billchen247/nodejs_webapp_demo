PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/mern_task_manager_week10
CLIENT_URL=http://localhost:5173

# A long random string. Rotating this invalidates every session.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# NODE_ENV controls several Week 10 behaviours:
#   - production: cookies use SameSite=None; Secure, errors hide stack traces,
#                 forgot-password response omits the dev token.
#   - development/test: cookies use SameSite=Lax (so no HTTPS is required
#                       during local dev), errors expose stack traces,
#                       forgot-password response includes `devToken` for
#                       easy testing without an email provider.
NODE_ENV=development

# For the one-shot admin seeding script (npm run seed:admin). You can also
# pass these as CLI arguments to the script instead of putting them in .env.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-8-chars
