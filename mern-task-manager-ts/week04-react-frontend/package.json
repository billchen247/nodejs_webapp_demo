{
  "name": "week04-react-frontend",
  "version": "1.0.0",
  "description": "Week 4 of the MERN Task Manager — React frontend introduced (mock data).",
  "type": "module",
  "author": "Bill Chen",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:client": "npm --prefix client run dev",
    "install:client": "npm --prefix client install",
    "test:client": "npm --prefix client run test",
    "test:client:coverage": "npm --prefix client run test:coverage"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^1.6.0",
    "mongodb-memory-server": "^9.2.0",
    "supertest": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
