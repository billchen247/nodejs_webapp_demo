# ---------------------------------------------------------------------------
# .env.example
#
# Copy this file to `.env` and edit the values. `.env` is git-ignored.
#
# The app calls `dotenv.config()` before reading any env var, so anything you
# put here is available on `process.env` in `src/config.ts`.
# ---------------------------------------------------------------------------

# The Mongo connection string. Pick ONE of:
#   * Local mongod:      mongodb://127.0.0.1:27017/todo_dev
#   * Docker mongo:      mongodb://mongo:27017/todo_dev
#   * MongoDB Atlas:     mongodb+srv://<user>:<pw>@<cluster>/todo_dev
#
# In test mode the app never reads this — the test suite starts an in-process
# `mongodb-memory-server` and injects its URI programmatically.
MONGODB_URI=mongodb://127.0.0.1:27017/todo_dev

# HTTP port. Defaults to 3003 (so all four sister projects can run at once:
# 3000, 3001, 3002, and 3003).
PORT=3003

# Origin allowed to call the API from a browser. Defaults to Vite's dev port.
ALLOWED_ORIGIN=http://localhost:5173
