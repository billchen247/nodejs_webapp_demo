<%- include('../partials/header', { title: title }) %>

<div class="auth-card">
    <h1>Sign up</h1>

    <% if (errors._) { %>
        <p class="form-error"><%= errors._ %></p>
    <% } %>

    <form method="post" action="/signup" class="auth-form" novalidate>
        <div class="field <%= errors.name ? 'has-error' : '' %>">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" value="<%= values.name || '' %>"
                   autofocus required maxlength="80">
            <% if (errors.name) { %><p class="error"><%= errors.name %></p><% } %>
        </div>

        <div class="field <%= errors.email ? 'has-error' : '' %>">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= values.email || '' %>"
                   required maxlength="200" autocomplete="email">
            <% if (errors.email) { %><p class="error"><%= errors.email %></p><% } %>
        </div>

        <div class="field <%= errors.password ? 'has-error' : '' %>">
            <label for="password">Password</label>
            <input type="password" id="password" name="password"
                   required minlength="8" autocomplete="new-password">
            <% if (errors.password) { %><p class="error"><%= errors.password %></p><% } %>
        </div>

        <div class="field <%= errors.confirmPassword ? 'has-error' : '' %>">
            <label for="confirmPassword">Confirm password</label>
            <input type="password" id="confirmPassword" name="confirmPassword"
                   required minlength="8" autocomplete="new-password">
            <% if (errors.confirmPassword) { %><p class="error"><%= errors.confirmPassword %></p><% } %>
        </div>

        <div class="form-actions">
            <button type="submit" class="button primary">Create account</button>
            <a href="/login" class="button">I already have an account</a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
