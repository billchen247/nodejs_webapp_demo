<%- include('../partials/header', { title: title }) %>

<h1>New todo</h1>

<form method="post" action="/todos" class="todo-form" novalidate>
    <div class="field <%= errors.title ? 'has-error' : '' %>">
        <label for="title">Title</label>
        <input
            type="text"
            id="title"
            name="title"
            value="<%= values.title || '' %>"
            autofocus
            required
            maxlength="200"
        >
        <% if (errors.title) { %>
            <p class="error"><%= errors.title %></p>
        <% } %>
    </div>

    <div class="field-inline">
        <input type="checkbox" id="completed" name="completed" <%= values.completed ? 'checked' : '' %>>
        <label for="completed">Already done?</label>
    </div>

    <div class="form-actions">
        <button type="submit" class="button primary">Create</button>
        <a href="/todos" class="button">Cancel</a>
    </div>
</form>

<%- include('../partials/footer') %>
