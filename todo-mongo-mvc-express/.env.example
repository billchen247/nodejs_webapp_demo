# ---------------------------------------------------------------------------
# .env.example
#
# Copy this file to `.env` and edit the values. `.env` is git-ignored.
#
# The app calls `dotenv.config()` before reading any env var, so anything you
# put here is available on `process.env` in `src/config.ts`.
# ---------------------------------------------------------------------------

# The Mongo connection string. Pick ONE of:
#   * Local mongod:      mongodb://127.0.0.1:27017/todo_mvc_dev
#   * Docker mongo:      mongodb://mongo:27017/todo_mvc_dev
#   * MongoDB Atlas:     mongodb+srv://<user>:<pw>@<cluster>/todo_mvc_dev
#
# In test mode the app never reads this — the test suite starts an in-process
# `mongodb-memory-server` and injects its URI programmatically.
MONGODB_URI=mongodb://127.0.0.1:27017/todo_mvc_dev

# HTTP port. Defaults to 3004 so all sibling projects can run at once
# (3000, 3001, 3002, 3003, and 3004).
PORT=3004
