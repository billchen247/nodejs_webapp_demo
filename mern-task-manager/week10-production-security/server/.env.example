# Week 10 — Production security
# All of these are required. The server refuses to start without JWT_SECRET.
# In production, set NODE_ENV=production so cookies get the Secure flag,
# error details are hidden, and rate limiters are enforced strictly.

# ----- Server -----
PORT=5000
NODE_ENV=development
# Trust the FIRST proxy hop (set to 1 behind a single reverse proxy like
# Nginx, Fly, Render, Vercel's edge, etc). Leave as 0 if the server is
# directly reachable. Express needs this to correctly identify the client
# IP, which rate limiting depends on.
TRUST_PROXY=0

# ----- Mongo -----
MONGODB_URI=mongodb://localhost:27017/taskmanager

# ----- CORS -----
# Comma-separated list of allowed origins. Do NOT use "*" with
# credentials — the browser refuses. Example for staging + prod:
#   CLIENT_URLS=https://tasks.example.com,https://staging.tasks.example.com
CLIENT_URLS=http://localhost:5173

# ----- JWT -----
# Generate a strong secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ----- Password reset -----
# How long a reset token is valid (minutes).
PASSWORD_RESET_TTL_MINUTES=30
# Where the reset email should link to on the frontend.
PASSWORD_RESET_URL_BASE=http://localhost:5173/reset-password

# ----- Rate limiting -----
# Globally expressed in "requests per window", window in seconds.
# These defaults are intentionally generous for development.
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
