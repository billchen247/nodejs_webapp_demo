{
  "name": "week10-server",
  "version": "1.0.0",
  "description": "Week 10 — Production security hardening on top of Week 9.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "NODE_ENV=production node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "make-admin": "node --env-file=.env scripts/makeAdmin.js",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage"
  },
  "keywords": [
    "mern",
    "security",
    "helmet",
    "rate-limit",
    "teaching"
  ],
  "author": "Bill Chen",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "cross-env": "^7.0.3",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0",
    "vitest": "^2.1.9"
  }
}
