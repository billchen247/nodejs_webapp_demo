{
  "name": "todo-connect-api",
  "version": "1.0.0",
  "description": "Educational Todo REST API built with the Connect middleware framework (Express's minimalist ancestor).",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "node --test test/",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' test/",
    "pretest:coverage:lcov": "node -e \"require('fs').mkdirSync('coverage',{recursive:true})\"",
    "test:coverage:lcov": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/"
  },
  "keywords": [
    "nodejs",
    "connect",
    "middleware",
    "rest",
    "api",
    "todo",
    "educational"
  ],
  "author": "Educational Example",
  "license": "MIT",
  "dependencies": {
    "connect": "^3.7.0",
    "serve-static": "^2.2.1",
    "swagger-ui-dist": "^5.33.0"
  }
}
